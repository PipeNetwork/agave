# Bootstrap ledger and key locations
# This file is only for create-genesis.sh. You still need a separate validator runtime env file
# such as /etc/agave/devnet/validator-1.env for the bootstrap validator itself.
SOLANA_KEYGEN_BIN=solana-keygen
SOLANA_GENESIS_BIN=solana-genesis
SOLANA_LEDGER_TOOL_BIN=solana-ledger-tool
IDENTITY_KEYPAIR=/etc/agave/keys/bootstrap-validator-identity.json
VOTE_ACCOUNT_KEYPAIR=/etc/agave/keys/bootstrap-validator-vote-account.json
STAKE_ACCOUNT_KEYPAIR=/etc/agave/keys/bootstrap-validator-stake-account.json
FAUCET_KEYPAIR=/etc/agave/keys/devnet-faucet.json
LEDGER_DIR=/var/lib/agave/bootstrap-validator/ledger
CLUSTER_INFO_FILE=/var/lib/agave/bootstrap-validator/ledger/cluster-info.env

# Genesis settings
CLUSTER_TYPE=development
HASHES_PER_TICK=auto
FAUCET_LAMPORTS=500000000000000000
BOOTSTRAP_VALIDATOR_LAMPORTS=500000000000
BOOTSTRAP_VALIDATOR_STAKE_LAMPORTS=500000000000
ENABLE_WARMUP_EPOCHS=true

# Optional tuning
# TICKS_PER_SLOT=64
# SLOTS_PER_EPOCH=8192
# TARGET_LAMPORTS_PER_SIGNATURE=5000
