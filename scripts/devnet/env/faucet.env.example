SOLANA_FAUCET_BIN=/opt/agave/bin/solana-faucet
FAUCET_KEYPAIR=/etc/agave/keys/devnet-faucet.json

# The current solana-faucet binary binds to fixed TCP port 9900 in this tree.
# There is no bind-address or port flag in this wrapper because the binary does not expose one.
FAUCET_SLICE_SECS=60
FAUCET_PER_TIME_CAP_SOL=100
FAUCET_PER_REQUEST_CAP_SOL=5

# Optional allowlist entries bypass IP-based limits.
# FAUCET_ALLOWED_IPS="127.0.0.1 10.0.0.10"
