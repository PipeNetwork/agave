# Publish a file like this for external validators who want to join your public fair devnet.
# The simplest operator workflow is to host it at a stable URL, for example:
#   https://devnet.example.org/public-fair-devnet.env
# They can source it and then run join-fair-validator.sh with only local key paths and, if needed,
# a per-validator SolanaCDN API token.

# Cluster identity
ENTRYPOINTS="<ENTRYPOINT_IP>:8001 <ENTRYPOINT_IP_2>:8001"
KNOWN_VALIDATORS="<VALIDATOR_PUBKEY_1> <VALIDATOR_PUBKEY_2> <VALIDATOR_PUBKEY_3>"
EXPECTED_GENESIS_HASH=<GENESIS_HASH>
EXPECTED_SHRED_VERSION=<SHRED_VERSION>

# SolanaCDN discovery. Prefer API-based discovery for public joiners.
SOLANACDN_API_BASE=https://api.pipedev.network
# SOLANACDN_API_TOKEN=<ISSUE_PER_VALIDATOR_TOKEN_SEPARATELY>

# If you do not use API-based discovery, publish explicit POP / control information instead.
# SOLANACDN_POPS="<POP_IP>:4819 <POP_IP_2>:4819 <POP_IP_3>:4819"
# SOLANACDN_CONTROL=<CONTROL_IP>:4820
# SOLANACDN_SERVER_NAME=solanacdn-pop
# SOLANACDN_TLS_CA_CERT_PATH=/etc/agave/solanacdn/ca.crt

# Public fair validators in this fork default to maximum protection.
FAIR_WITNESS_QUORUM=3
