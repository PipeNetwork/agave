# Validator identity and storage
AGAVE_VALIDATOR_BIN=/opt/agave/bin/agave-validator
IDENTITY_KEYPAIR=/etc/agave/keys/validator-1-identity.json
VOTE_ACCOUNT_KEYPAIR=/etc/agave/keys/validator-1-vote-account.json
AUTHORIZED_VOTER_KEYPAIR=/etc/agave/keys/validator-1-authorized-voter.json
LEDGER_DIR=/var/lib/agave/validator-1/ledger
ACCOUNTS_DIR=/var/lib/agave/validator-1/accounts
SNAPSHOTS_DIR=/var/lib/agave/validator-1/snapshots

# Networking
RPC_BIND_ADDRESS=127.0.0.1
RPC_PORT=8899
GOSSIP_PORT=8001
DYNAMIC_PORT_RANGE=8002-8020
PRIVATE_RPC=true

# Cluster membership
# Replace these RFC 5737 documentation IPs with your real public gossip entrypoints.
# For the first validator in a brand new cluster, leave ENTRYPOINTS empty on first start.
ENTRYPOINTS="203.0.113.10:8001 203.0.113.11:8001"
KNOWN_VALIDATORS="ValidatorPubkey1 ValidatorPubkey2 ValidatorPubkey3"
# For the first validator in a brand new cluster, leave these empty until you have created genesis.
EXPECTED_GENESIS_HASH=ReplaceWithGenesisHash
EXPECTED_SHRED_VERSION=ReplaceWithShredVersion

# Validator role
NO_VOTING=false
FULL_RPC_API=false
LIMIT_LEDGER_SIZE=true

# SolanaCDN and fair-ordering settings
# For a local cluster without SolanaCDN infrastructure, set both SOLANACDN_ENABLE=false and
# FAIR_ENABLE=false.
SOLANACDN_ENABLE=true
SOLANACDN_MODE=hybrid
# If multiple validators on one host use SolanaCDN, give each a unique metrics port.
SOLANACDN_API_BASE=https://api.pipedev.network
SOLANACDN_METRICS_ADDR=127.0.0.1:9100
FAIR_ENABLE=true
FAIR_WITNESS_QUORUM=3

# Optional RPC airdrop discovery for private validator RPCs:
# RPC_FAUCET_ADDRESS=faucet.devnet.invalid:9900

# Optional explicit POP discovery instead of the Pipe API:
# Replace these RFC 5737 documentation IPs with your real POP/control addresses.
# SOLANACDN_POPS="198.51.100.10:4819 198.51.100.11:4819"
# SOLANACDN_CONTROL=198.51.100.20:4820
# SOLANACDN_SERVER_NAME=pop.devnet.example.com
# SOLANACDN_TLS_CA_CERT_PATH=/etc/agave/solanacdn/ca.crt
# SOLANACDN_TLS_INSECURE_SKIP_VERIFY=false

# Extra flags are appended as-is. Keep this simple and space-delimited.
EXTRA_FLAGS=
