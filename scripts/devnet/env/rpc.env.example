# RPC identity and storage
AGAVE_VALIDATOR_BIN=/opt/agave/bin/agave-validator
IDENTITY_KEYPAIR=/etc/agave/keys/rpc-1-identity.json
LEDGER_DIR=/var/lib/agave/rpc-1/ledger
ACCOUNTS_DIR=/var/lib/agave/rpc-1/accounts
SNAPSHOTS_DIR=/var/lib/agave/rpc-1/snapshots

# Networking
RPC_BIND_ADDRESS=0.0.0.0
RPC_PORT=8899
GOSSIP_PORT=8001
DYNAMIC_PORT_RANGE=8002-8020
PRIVATE_RPC=false

# Cluster membership
# Replace these RFC 5737 documentation IPs with your real public gossip entrypoints.
# For a single-host local cluster, point this at the bootstrap validator, for example 127.0.0.1:8001.
ENTRYPOINTS="203.0.113.10:8001 203.0.113.11:8001"
KNOWN_VALIDATORS="ValidatorPubkey1 ValidatorPubkey2 ValidatorPubkey3"
EXPECTED_GENESIS_HASH=ReplaceWithGenesisHash
EXPECTED_SHRED_VERSION=ReplaceWithShredVersion

# RPC role
NO_VOTING=true
FULL_RPC_API=true
LIMIT_LEDGER_SIZE=true
ENABLE_RPC_TRANSACTION_HISTORY=true
ENABLE_EXTENDED_TX_METADATA_STORAGE=true
RPC_FAUCET_ADDRESS=faucet.devnet.invalid:9900

# Public RPC nodes do not need SolanaCDN or fair-ordering to serve JSON-RPC.
# Turn these on only if you intentionally want the RPC node to participate in that path too.
SOLANACDN_ENABLE=false
FAIR_ENABLE=false

# Optional: enable these only if you intentionally want SolanaCDN on the RPC node too.
# SOLANACDN_MODE=hybrid
# SOLANACDN_API_BASE=https://api.pipedev.network
# If multiple nodes on one host use SolanaCDN, give each a unique metrics port.
# SOLANACDN_METRICS_ADDR=127.0.0.1:9200
# FAIR_WITNESS_QUORUM=3

EXTRA_FLAGS=
